<?xml version="1.0" encoding="UTF-8"?>
<!--
  Glass TV — manifesto do aplicativo web Tizen (Samsung TV).

  Privilégios: somente nível PUBLIC (instala com certificado Samsung de
  distribuidor público, sem conta de parceiro). Cada um está justificado em
  docs/03-permissoes-e-seguranca.md.

  Rede: o app NÃO solicita http://tizen.org/privilege/internet e não declara
  <access origin>; portanto não acessa a internet nem a rede local.
-->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://glasstv.local/app" version="0.1.0" viewmodes="maximized">
  <tizen:application id="GlassTV001.GlassTV" package="GlassTV001" required_version="5.5"/>
  <name>Glass TV</name>
  <description>Tela inicial minimalista com dock de apps e acesso rápido às entradas HDMI.</description>
  <author>Glass TV (uso pessoal)</author>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>

  <!-- Listar apps instalados (tizen.application.getAppsInfo) -->
  <tizen:privilege name="http://tizen.org/privilege/application.info"/>
  <!-- Abrir apps (tizen.application.launch / launchAppControl) -->
  <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
  <!-- Exibir a entrada HDMI na janela de TV do app (tizen.tvwindow) -->
  <tizen:privilege name="http://tizen.org/privilege/tv.window"/>
  <!-- Registrar as teclas 1–4 do controle como atalho de HDMI (tizen.tvinputdevice) -->
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>

  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                 encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
